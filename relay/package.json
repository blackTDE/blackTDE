    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.288",
    "@xterm/xterm": "6.1.0-beta.288",
