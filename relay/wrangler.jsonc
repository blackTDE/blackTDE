{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tde-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOM",
        "class_name": "RelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
